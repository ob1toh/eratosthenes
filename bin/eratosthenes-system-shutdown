#!/bin/bash

# eratosthenes:summary=Shut down after closing application windows
# eratosthenes:examples=eratosthenes shutdown | eratosthenes system shutdown
# eratosthenes:aliases=eratosthenes shutdown

eratosthenes-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &

# Now close all windows
eratosthenes-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
