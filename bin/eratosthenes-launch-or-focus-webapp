#!/bin/bash

# eratosthenes:summary=Launch or focus on a given web app identified by the window-pattern.
# eratosthenes:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: eratosthenes-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="eratosthenes-launch-webapp $@"

exec eratosthenes-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
