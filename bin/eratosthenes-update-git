#!/bin/bash

# eratosthenes:summary=Pull the latest Eratosthenes git changes

set -e

echo -e "\e[32mUpdate Eratosthenes\e[0m"

eratosthenes-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true
hyprctl eval 'hl.config({ debug = { suppress_errors = true } })' &>/dev/null || true

git -C $ERATOSTHENES_PATH pull --autostash
git -C $ERATOSTHENES_PATH --no-pager diff --check || git -C $ERATOSTHENES_PATH reset --merge

hyprctl reload &>/dev/null || true
