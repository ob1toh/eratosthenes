#!/bin/bash

# eratosthenes:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# eratosthenes:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
eratosthenes-pkg-add heroic-games-launcher-bin
eratosthenes-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
