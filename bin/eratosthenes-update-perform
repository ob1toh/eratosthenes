#!/bin/bash

# eratosthenes:summary=Run the full Eratosthenes update pipeline
# eratosthenes:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "+noidle" })' &>/dev/null || hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
eratosthenes-update-keyring
eratosthenes-update-available-reset
eratosthenes-update-system-pkgs
eratosthenes-migrate
eratosthenes-update-aur-pkgs
eratosthenes-update-orphan-pkgs
eratosthenes-hook post-update

eratosthenes-update-analyze-logs

eratosthenes-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "-noidle" })' &>/dev/null || hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
