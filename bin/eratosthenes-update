#!/bin/bash

# eratosthenes:summary=Update Eratosthenes and system packages
# eratosthenes:args=[-y]
# eratosthenes:examples=eratosthenes update | eratosthenes update -y
# eratosthenes:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $ERATOSTHENES_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env ERATOSTHENES_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/eratosthenes-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, open an issue at https://github.com/ob1toh/eratosthenes/issues\033[0m"' ERR

if [[ $1 == "-y" ]] || eratosthenes-update-confirm; then
  eratosthenes-snapshot create || (($? == 127))
  eratosthenes-update-git
  eratosthenes-update-perform
fi
