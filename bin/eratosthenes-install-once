#!/bin/bash

# eratosthenes:summary=Install the ONCE service, enable its background service, and launch the TUI.
# eratosthenes:requires-sudo=true

echo "Installing ONCE..."
eratosthenes-pkg-add once-bin

echo "Enabling ONCE background service..."
sudo systemctl enable --now once-background.service

echo -e "\nLaunching ONCE..."
once
