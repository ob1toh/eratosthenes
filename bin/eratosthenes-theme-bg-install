#!/bin/bash

# eratosthenes:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.config/eratosthenes/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/eratosthenes/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
