#!/bin/bash

# eratosthenes:summary=Set the branch for Eratosthenes's git repository.
# eratosthenes:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: eratosthenes-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $ERATOSTHENES_PATH switch $branch
