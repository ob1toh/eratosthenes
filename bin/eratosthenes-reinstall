#!/bin/bash

# eratosthenes:summary=Reinstall Eratosthenes packages and reset default configs
# eratosthenes:requires-sudo=true

set -e

# Attempt to reinstall all default Eratosthenes packages and reset all the default configs.

echo -e "This will reinstall all the default Eratosthenes packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  eratosthenes-reinstall-git
  eratosthenes-reinstall-pkgs
  eratosthenes-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && eratosthenes-system-reboot
fi
