#!/bin/bash

# eratosthenes:summary=Finish the installation of Eratosthenes with items that can only be done after logging in.
# eratosthenes:requires-sudo=true

set -e

FIRST_RUN_MODE=~/.local/state/eratosthenes/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$ERATOSTHENES_PATH/install/first-run/battery-monitor.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/recover-internal-monitor.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/cleanup-reboot-sudoers.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/firewall.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/dns-resolver.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/gnome-theme.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/gdk-scale.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/swayosd.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/gtk-primary-paste.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/elephant.sh"
  eratosthenes-hook-install post-update "$ERATOSTHENES_PATH/install/first-run/install-voxtype.hook"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$ERATOSTHENES_PATH/install/first-run/welcome.sh"
  bash "$ERATOSTHENES_PATH/install/first-run/wifi.sh"
fi
