#!/bin/bash

# eratosthenes:summary=Reinstall the stable Eratosthenes source directory from git

set -e

# Reinstall the Eratosthenes configuration directory from the git source.

git clone --depth=1 --branch master "https://github.com/ob1toh/eratosthenes.git" ~/.local/share/eratosthenes-new >/dev/null
mv $ERATOSTHENES_PATH ~/.local/share/eratosthenes-old
mv ~/.local/share/eratosthenes-new $ERATOSTHENES_PATH
