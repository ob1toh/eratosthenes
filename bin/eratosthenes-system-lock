#!/bin/bash

# eratosthenes:summary=Lock the computer and turn off the display
# eratosthenes:group=system
# eratosthenes:name=lock
# eratosthenes:examples=eratosthenes system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    eratosthenes-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.eratosthenes.screensaver

if [[ ${ERATOSTHENES_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    eratosthenes-brightness-keyboard off
    eratosthenes-brightness-display off
  ) &
fi
