#!/bin/bash

# eratosthenes:summary=Apply an Eratosthenes theme
# eratosthenes:args=<theme-name>
# eratosthenes:examples=eratosthenes theme list | eratosthenes theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: eratosthenes-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/eratosthenes/current/theme"
NEXT_THEME_PATH="$HOME/.config/eratosthenes/current/next-theme"
USER_THEMES_PATH="$HOME/.config/eratosthenes/themes"
ERATOSTHENES_THEMES_PATH="$ERATOSTHENES_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $ERATOSTHENES_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$ERATOSTHENES_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  eratosthenes-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
eratosthenes-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/eratosthenes/current/theme.name"

# Change background with theme
if [[ $ERATOSTHENES_THEME_SKIP_BACKGROUND != "1" ]]; then
  eratosthenes-theme-bg-next
fi

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  eratosthenes-restart-waybar
fi
eratosthenes-restart-swayosd
eratosthenes-restart-terminal
eratosthenes-restart-hyprctl
eratosthenes-restart-btop
eratosthenes-restart-opencode
eratosthenes-restart-mako
eratosthenes-restart-helix

# Change app-specific themes
eratosthenes-theme-set-foot
eratosthenes-theme-set-gnome
eratosthenes-theme-set-browser
eratosthenes-theme-set-vscode
eratosthenes-theme-set-obsidian
eratosthenes-theme-set-keyboard

# Call hook on theme set
eratosthenes-hook theme-set "$THEME_NAME" >/dev/null

# Warm the background selector cache after the theme is applied, off the critical path.
eratosthenes-theme-bg-cache >/dev/null 2>&1 &
