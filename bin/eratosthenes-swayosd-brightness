#!/bin/bash

# eratosthenes:summary=Display brightness level using SwayOSD on the current monitor.
# eratosthenes:args=<0-100>
# eratosthenes:examples=eratosthenes swayosd brightness 0 | eratosthenes swayosd brightness 50 | eratosthenes swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

eratosthenes-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "$(printf '%3d%%' "$percent")"
