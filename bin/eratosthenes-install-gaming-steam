#!/bin/bash

# eratosthenes:summary=Install Steam and graphics drivers selected for this system
# eratosthenes:requires-sudo=true

set -e

echo "Installing Steam..."
eratosthenes-pkg-add steam
eratosthenes-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
