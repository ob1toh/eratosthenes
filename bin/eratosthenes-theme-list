#!/bin/bash

# eratosthenes:summary=List available themes
# eratosthenes:examples=eratosthenes theme list | eratosthenes theme set "Tokyo Night"

{
  find ~/.config/eratosthenes/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$ERATOSTHENES_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
