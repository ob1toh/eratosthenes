#!/bin/bash

# eratosthenes:summary=Set the Eratosthenes channel, which dictates what git branch and package repository is used.
# eratosthenes:args=<stable|rc|edge|dev>
# eratosthenes:requires-sudo=true

if (($# == 0)); then
  echo "Usage: eratosthenes-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") eratosthenes-branch-set "master" && eratosthenes-refresh-pacman "stable" ;;
"rc") eratosthenes-branch-set "rc" && eratosthenes-refresh-pacman "rc" ;;
"edge") eratosthenes-branch-set "master" && eratosthenes-refresh-pacman "edge" ;;
"dev") eratosthenes-branch-set "dev" && eratosthenes-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

eratosthenes-update -y
