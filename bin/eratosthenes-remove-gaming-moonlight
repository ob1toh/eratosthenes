#!/bin/bash

# eratosthenes:summary=Remove Moonlight and its configs and caches.
# eratosthenes:requires-sudo=true

set -e

eratosthenes-pkg-drop moonlight-qt

rm -rf \
  "$HOME/.config/Moonlight Game Streaming Project" \
  "$HOME/.cache/Moonlight Game Streaming Project"

echo ""
echo "Moonlight and its data have been removed."
